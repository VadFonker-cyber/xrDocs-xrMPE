# Use the same names for GitHub Actions secrets when deploying to GitHub Pages.
VITE_UMAMI_WEBSITE_ID=
# Free self-hosted Umami example: https://stats.example.com/script.js
VITE_UMAMI_SCRIPT_URL=
# Comma-separated hostnames where the tracker is allowed to run.
VITE_UMAMI_DOMAINS=vadfonker-cyber.github.io
# Set to true only when you need to verify statistics locally.
VITE_ENABLE_STATISTICS_IN_DEV=false

# GitHub Pages build settings. Use NOINDEX=true only for preview builds.
VITE_BASE_PATH=/xrDocs-xrMPE/
SITE_URL=https://vadfonker-cyber.github.io/xrDocs-xrMPE/
NOINDEX=false
